<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Live animated fluid pink dust curves behind the entire UI -->
    <com.pingpong.tracker.ui.PinkDustBackgroundView
        android:id="@+id/pink_dust_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Foreground Clean Dynamic UI -->
    <LinearLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Clean White & Rose Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Logo PingPong Tracker"
                android:src="@drawable/ic_brand_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="PING TRACKER"
                    android:textColor="#1E1118"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/header_status_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_status_dot" />

                    <TextView
                        android:id="@+id/header_sync_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="MAJ --:--"
                        android:textColor="#9D4E75"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_header_refresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_dark"
                android:contentDescription="Synchroniser"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh"
                android:tint="#DB2777" />

            <ImageButton
                android:id="@+id/btn_header_settings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_dark"
                android:contentDescription="Réglages"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_settings"
                android:tint="#DB2777" />
        </LinearLayout>

        <!-- Error banner -->
        <TextView
            android:id="@+id/banner_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFE4E6"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp"
            android:textColor="#BE123C"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Ergonomic 1-Tap Quick Actions Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/quick_btn_notifs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Alertes"
                    android:textColor="#9D174D"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_btn_widget"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="+ Widget"
                    android:textColor="#9D174D"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quick_btn_club"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_button_gold"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="+ Club"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Main Scrollable Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB 1: LIVE & MATCHS -->
            <ScrollView
                android:id="@+id/tab_matches_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="18dp">

                    <!-- Hero Spotlight Match Card (Compact Frosted Pearl & Rose) -->
                    <LinearLayout
                        android:id="@+id/hero_match_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_hero_card"
                        android:clickable="true"
                        android:elevation="3dp"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hero_kicker"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:letterSpacing="0.06"
                                android:maxLines="1"
                                android:text="À LA UNE"
                                android:textColor="#DB2777"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hero_countdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_live_pill"
                                android:fontFamily="monospace"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:textColor="#BE123C"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Matchup Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Home Side -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/hero_crest_home"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_crest_bruille"
                                    android:gravity="center"
                                    android:letterSpacing="0.04"
                                    android:textColor="#1E1118"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/hero_home_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:textColor="#1E1118"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Center Score / VS + Ticking Clock -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingHorizontal="8dp">

                                <TextView
                                    android:id="@+id/hero_center_score"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="vs"
                                    android:textColor="#EC4899"
                                    android:textSize="24sp"
                                    android:textStyle="bold|italic" />

                                <TextView
                                    android:id="@+id/hero_ticking_clock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:background="@drawable/bg_score_box"
                                    android:fontFamily="monospace"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:textColor="#9D174D"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/hero_broadcast"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="#7A5C6B"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Away Side -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/hero_crest_away"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_crest_neutral"
                                    android:gravity="center"
                                    android:letterSpacing="0.04"
                                    android:textColor="#9D174D"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/hero_away_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:ellipsize="end"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:textColor="#3B2330"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:background="#26EC4899" />

                        <!-- Rose CTA Strip -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/hero_followed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="#7A5C6B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/hero_vpn_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_vpn_pill"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="VPN"
                                android:textColor="#B45309"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/hero_lequipe_btn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_lequipe_pill"
                                android:clickable="true"
                                android:focusable="true"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="6dp"
                                android:text="L'ÉQUIPE ↗"
                                android:textColor="#FFFFFF"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_button_gold"
                                android:letterSpacing="0.04"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="Live →"
                                android:textColor="#FFFFFF"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Filter Pills -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/matches_filter_chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/matches_empty_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_card"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="Aucun match disponible. Appuyez sur l'icône d'actualisation ou vérifiez l'URL dans les réglages."
                        android:textColor="#7A5C6B"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/matches_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <!-- TAB 2: CLUBS -->
            <ScrollView
                android:id="@+id/tab_clubs_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Club Identity Hub Banner -->
                    <LinearLayout
                        android:id="@+id/club_hub_banner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_club_banner"
                        android:elevation="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="18dp">

                        <TextView
                            android:id="@+id/club_hub_crest"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/bg_crest_bruille"
                            android:gravity="center"
                            android:text="BR"
                            android:textColor="#047857"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.1"
                                android:text="PRO A MESSIEURS"
                                android:textColor="#059669"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/club_hub_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="CTT Bruille"
                                android:textColor="#1E1118"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/club_hub_subtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="1 club suivi · 0 match à venir"
                                android:textColor="#7A5C6B"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.1"
                            android:text="MES CLUBS SUIVIS"
                            android:textColor="#DB2777"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/btn_add_club"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_button_gold"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_marginEnd="4dp"
                                android:src="@drawable/ic_plus"
                                android:tint="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ajouter"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Followed Club Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/clubs_chips_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/clubs_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:letterSpacing="0.1"
                        android:text="CALENDRIER &amp; RÉSULTATS"
                        android:textColor="#7A5C6B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/clubs_empty_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_surface_card"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="Aucun match trouvé pour ce club dans le flux actuel."
                        android:textColor="#7A5C6B"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/clubs_matches_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>

            <!-- TAB 3: TABLEAUX / COMPÉTITIONS INTER -->
            <ScrollView
                android:id="@+id/tab_bracket_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="16dp">

                    <!-- Tournament Selector Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/tournament_chips_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Tournament Hero Banner -->
                    <LinearLayout
                        android:id="@+id/tournament_header_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_tournament_banner"
                        android:elevation="3dp"
                        android:orientation="vertical"
                        android:padding="18dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tournament_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="WTT FINALS"
                            android:textColor="#DB2777"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tournament_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#1E1118"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tournament_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#7A5C6B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Interactive Horizontal Bracket Tree -->
                    <HorizontalScrollView
                        android:id="@+id/bracket_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingHorizontal="16dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/bracket_columns_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/bracket_empty_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:background="@drawable/bg_surface_card"
                        android:gravity="center"
                        android:padding="28dp"
                        android:text="Aucun tableau international disponible dans le flux actuel."
                        android:textColor="#7A5C6B"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- International Matches List below bracket -->
                    <TextView
                        android:id="@+id/intl_matches_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:letterSpacing="0.1"
                        android:text="MATCHS INTERNATIONAUX SUIVIS"
                        android:textColor="#DB2777"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/intl_matches_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Floating Frosted White & Rose Pill Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_nav_pill"
                android:elevation="6dp"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <LinearLayout
                    android:id="@+id/nav_matches"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/nav_matches_indicator"
                        android:layout_width="24dp"
                        android:layout_height="2.5dp"
                        android:layout_marginBottom="5dp"
                        android:background="#EC4899" />

                    <ImageView
                        android:id="@+id/nav_matches_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_tab_matches"
                        android:tint="#DB2777" />

                    <TextView
                        android:id="@+id/nav_matches_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="À l'affiche"
                        android:textColor="#DB2777"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_clubs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/nav_clubs_indicator"
                        android:layout_width="24dp"
                        android:layout_height="2.5dp"
                        android:layout_marginBottom="5dp"
                        android:background="#EC4899"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/nav_clubs_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_tab_clubs"
                        android:tint="#A08493" />

                    <TextView
                        android:id="@+id/nav_clubs_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Clubs"
                        android:textColor="#A08493"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_bracket"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <View
                        android:id="@+id/nav_bracket_indicator"
                        android:layout_width="24dp"
                        android:layout_height="2.5dp"
                        android:layout_marginBottom="5dp"
                        android:background="#EC4899"
                        android:visibility="invisible" />

                    <ImageView
                        android:id="@+id/nav_bracket_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/ic_tab_bracket"
                        android:tint="#A08493" />

                    <TextView
                        android:id="@+id/nav_bracket_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tableaux"
                        android:textColor="#A08493"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
