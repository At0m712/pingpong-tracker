<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:orientation="vertical">

    <!-- Top Editorial Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#09090B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="3dp"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="#E11D48" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="PING TRACKER"
                android:textColor="#FAFAFA"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/header_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="MAJ --:--"
                android:textColor="#71717A"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_header_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_dark"
            android:contentDescription="Synchroniser"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            android:tint="#E4E4E7" />

        <ImageButton
            android:id="@+id/btn_header_settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_dark"
            android:contentDescription="Réglages"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            android:tint="#E4E4E7" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F1F23" />

    <!-- Error banner (hidden unless error) -->
    <TextView
        android:id="@+id/banner_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3B0F1A"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:textColor="#FDA4AF"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Main Scrollable Content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: LIVE & MATCHS -->
        <ScrollView
            android:id="@+id/tab_matches_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Filter Pills -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/matches_filter_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/matches_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="Aucun match disponible. Appuyez sur l'icône d'actualisation ou vérifiez l'URL dans les réglages."
                    android:textColor="#71717A"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/matches_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: CLUBS -->
        <ScrollView
            android:id="@+id/tab_clubs_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.06"
                        android:text="MES CLUBS SUIVIS"
                        android:textColor="#A1A1AA"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/btn_add_club"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_button_accent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_plus"
                            android:tint="#FFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ajouter un club"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Followed Club Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/clubs_chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/clubs_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.06"
                    android:text="CALENDRIER &amp; RÉSULTATS"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/clubs_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="Aucun match trouvé pour ce club dans le flux actuel."
                    android:textColor="#71717A"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/clubs_matches_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 3: TABLEAUX / COMPÉTITIONS INTER -->
        <ScrollView
            android:id="@+id/tab_bracket_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <!-- Tournament Selector Chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tournament_chips_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Tournament Header -->
                <LinearLayout
                    android:id="@+id/tournament_header_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_surface_card"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tournament_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="WTT CHAMPIONS"
                        android:textColor="#F59E0B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tournament_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#FAFAFA"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tournament_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#A1A1AA"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Interactive Horizontal Bracket Tree -->
                <HorizontalScrollView
                    android:id="@+id/bracket_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/bracket_columns_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/bracket_empty_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/bg_surface_card"
                    android:gravity="center"
                    android:padding="28dp"
                    android:text="Aucun tableau international disponible dans le flux actuel."
                    android:textColor="#71717A"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- International Matches List below bracket -->
                <TextView
                    android:id="@+id/intl_matches_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.06"
                    android:text="MATCHS INTERNATIONAUX SUIVIS"
                    android:textColor="#A1A1AA"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/intl_matches_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F1F23" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#0F0F12"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/nav_matches"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_matches_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tab_matches"
                android:tint="#FAFAFA" />

            <TextView
                android:id="@+id/nav_matches_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Matchs"
                android:textColor="#FAFAFA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_clubs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_clubs_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tab_clubs"
                android:tint="#71717A" />

            <TextView
                android:id="@+id/nav_clubs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Clubs"
                android:textColor="#71717A"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_bracket"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nav_bracket_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tab_bracket"
                android:tint="#71717A" />

            <TextView
                android:id="@+id/nav_bracket_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tableaux"
                android:textColor="#71717A"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
