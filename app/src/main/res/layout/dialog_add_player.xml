<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="AJOUTER UN JOUEUR"
        android:textColor="#1E1118"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Saisissez n'importe quel joueur (photo auto) ou choisissez dans la liste."
        android:textColor="#7A5C6B"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/add_player_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_dark"
        android:hint="Ex. Truls Möregårdh, Fan Zhendong..."
        android:inputType="textPersonName|textCapWords"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="#1E1118"
        android:textColorHint="#B090A0"
        android:textSize="13sp" />

    <Button
        android:id="@+id/add_player_confirm"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_accent"
        android:text="Ajouter ce joueur"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.06"
        android:text="SUGGESTIONS WTT &amp; FRANCE"
        android:textColor="#DB2777"
        android:textSize="10sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <LinearLayout
            android:id="@+id/add_player_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
