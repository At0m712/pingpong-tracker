<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_surface_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <!-- Left 3dp accent bar -->
    <View
        android:id="@+id/item_accent_bar"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="12dp"
        android:layout_marginStart="2dp"
        android:background="#3B82F6" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <!-- Header row: competition + status/time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_comp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textColor="#A1A1AA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#E4E4E7"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Home Row with monogram crest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_crest_home"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_crest_neutral"
                android:gravity="center"
                android:textColor="#FAFAFA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FAFAFA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_score_home"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_score_box"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#FAFAFA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Away Row with monogram crest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_crest_away"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_crest_neutral"
                android:gravity="center"
                android:textColor="#D4D4D8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_away"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#D4D4D8"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/item_score_away"
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_score_box"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#D4D4D8"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Subtle footer: followed + broadcast + optional VPN pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#71717A"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/item_vpn_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_vpn_pill"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="VPN"
                android:textColor="#FBBF24"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
