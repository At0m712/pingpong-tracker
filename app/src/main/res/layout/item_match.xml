<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_surface_card"
    android:clickable="true"
    android:elevation="2dp"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingEnd="12dp">

    <!-- Left 3dp status/club accent indicator -->
    <View
        android:id="@+id/item_accent_bar"
        android:layout_width="3dp"
        android:layout_height="44dp"
        android:layout_marginStart="2dp"
        android:background="#EC4899" />

    <!-- Main compact content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingEnd="8dp">

        <!-- Micro header: competition + countdown + VPN badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_comp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:textColor="#9D4E75"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_vpn_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vpn_pill"
                android:maxLines="1"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:text="VPN"
                android:textColor="#B45309"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/item_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="#DB2777"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Home Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_crest_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_crest_neutral"
                android:gravity="center"
                android:textColor="#9D174D"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#1E1118"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_score_home"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_score_box"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#1E1118"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Away Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_crest_away"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_crest_neutral"
                android:gravity="center"
                android:textColor="#9D174D"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_away"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#4A303E"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/item_score_away"
                android:layout_width="24dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_score_box"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="#4A303E"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Meta line (followed + broadcast + optional L'Équipe direct app pill) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8A6B7B"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/item_calendar_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_score_box"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="+ Agenda"
                android:textColor="#9D174D"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_share_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_score_box"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Partager"
                android:textColor="#7A5C6B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_lequipe_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_lequipe_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="L'ÉQUIPE ↗"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right 1-tap Watch Cue -->
    <TextView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_score_box"
        android:gravity="center"
        android:text="▶"
        android:textColor="#DB2777"
        android:textSize="11sp" />
</LinearLayout>
