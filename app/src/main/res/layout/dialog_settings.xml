<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#131316"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="RÉGLAGES"
        android:textColor="#FAFAFA"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/settings_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#A1A1AA"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="URL du flux JSON (matches.json)"
        android:textColor="#D4D4D8"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/settings_input_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_dark"
        android:hint="https://TON_PSEUDO.github.io/pingpong-tracker/matches.json"
        android:inputType="textUri"
        android:maxLines="2"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textColor="#FAFAFA"
        android:textColorHint="#52525B"
        android:textSize="12sp" />

    <Button
        android:id="@+id/settings_btn_save_url"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_accent"
        android:text="Enregistrer et synchroniser"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#27272A" />

    <Button
        android:id="@+id/settings_btn_pin_widget"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_button_dark"
        android:text="Épingler le widget sur l'écran d'accueil"
        android:textAllCaps="false"
        android:textColor="#FAFAFA"
        android:textSize="13sp" />

    <Button
        android:id="@+id/settings_btn_battery"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_button_dark"
        android:text="Optimisation batterie (synchro 15 min)"
        android:textAllCaps="false"
        android:textColor="#D4D4D8"
        android:textSize="13sp" />
</LinearLayout>
